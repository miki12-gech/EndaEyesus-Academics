# ============================================================
# Enda Eyesus Gibi Gubae Academic Mini App - Environment Setup
# ============================================================
# IMPORTANT: Never commit your real .env.local file to GitHub!
# Add these exact variables inside Vercel -> Project Settings -> Environment Variables.

# 1. Neon Serverless PostgreSQL Pooled Connection String
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Telegram Bot Token from @BotFather (@EndaEyesusAcademicBot)
TELEGRAM_BOT_TOKEN="YOUR_ROTATED_BOT_TOKEN_HERE"

# 3. Your deployed Vercel URL (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project-name.vercel.app"

# 4. Comma-separated Telegram numeric User IDs of Admins (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS="123456789"

# 5. Backup PIN for accessing /admin dashboard from PC or Browser
ADMIN_DASHBOARD_PIN="2019admin"

# 6. Secret token used to verify Telegram Webhook requests (any random strong string)
WEBHOOK_SECRET="enda-eyesus-academic-secret-2019"
